{
  "manifest_version": 3,
  "name": "PanelLens Browser Reader",
  "version": "0.3.0",
  "description": "Predictive, bounded translation prefetch for compatible image-based readers.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PanelLens"
  }
}
